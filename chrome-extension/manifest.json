{
    "manifest_version": 3,
    "name": "Zoom Transcriber",
    "version": "1.0",
    "description": "Live transcription for Zoom meetings",
    "permissions": [
      "tabCapture",
      "activeTab",
      "scripting",
      "offscreen"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "Zoom Transcriber"
    }
  }